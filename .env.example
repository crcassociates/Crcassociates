# Copy this file to .env and fill in the real values. .env is git-ignored.
# Never put real keys in THIS file - it is committed to GitHub.

# Supabase: Project Settings -> Data API / API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_ANON_KEY=
# Server-side only. Never put this in the web page code.
SUPABASE_SERVICE_ROLE_KEY=
